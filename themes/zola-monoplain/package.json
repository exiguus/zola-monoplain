{
  "name": "zola-monoplain-theme",
  "version": "1.0.0",
  "description": "mono/plain; a11y=true; An accessible, monospace plain Zola Theme",
  "scripts": {
    "test": "echo \"Warning: no test specified\" && exit 0",
    "test:a11y": "node ./scripts/pa11y.cjs",
    "check": "pnpm check:zola",
    "check:zola": "if command -v zola &> /dev/null; then exit 0; else echo 'Zola is not installed' && exit 1; fi",
    "dev": "pnpm check && pnpm cp:loaddata &&zola serve --drafts",
    "build": "pnpm check && pnpm cp:loaddata && zola build",
    "cp:loaddata": "./scripts/cp-loaddata.sh",
    "cp:icons": "mkdir -p ./static/images/icons && cp ./node_modules/@tabler/icons/icons/outline/*.svg ./static/images/icons/",
    "postinstall": "pnpm cp:icons && pnpm cp:loaddata"
  },
  "keywords": [
    "zola",
    "theme",
    "monospace",
    "plain",
    "accessible",
    "a11y"
  ],
  "author": "Simon Gattner",
  "license": "MIT",
  "dependencies": {
    "@tabler/icons": "^3.46.0"
  },
  "engines": {
    "pnpm": ">=10.0.0 <13.0.0",
    "npm": ">=10.0.0 <13.0.0",
    "node": ">=22.0.0 <25.0.0"
  }
}
